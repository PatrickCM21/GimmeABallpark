{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gimmeaballpark",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create Game Hub",
        "description": "Create a Hub post where users can create Gimme a Ballpark games",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/hub-create"
      },
      {
        "label": "Trigger Daily Ballpark",
        "description": "Manually trigger the next Daily Ballpark post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/trigger-daily"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 9 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}